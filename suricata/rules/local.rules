# Local signatures, tuned to this lab's attack simulator so alerts are
# guaranteed even if the ET Open ruleset's phrasing differs slightly.
# SID range 9000000+ is the Suricata convention for locally authored rules.
# Docs: https://docs.suricata.io/en/latest/rules/intro.html

alert http any any -> any any (msg:"LAB SQL Injection attempt (UNION/OR 1=1)"; \
  flow:to_server,established; http.request_body; \
  pcre:"/(union(\s|%20)+select|or(\s|%20)+1(\s|%20)*=(\s|%20)*1|'\s*or\s*')/i"; \
  classtype:web-application-attack; sid:9000001; rev:1;)

alert http any any -> any any (msg:"LAB SQL Injection attempt in URI"; \
  flow:to_server,established; http.uri; \
  content:"UNION"; nocase; content:"SELECT"; nocase; distance:0; \
  classtype:web-application-attack; sid:9000002; rev:1;)

alert http any any -> any any (msg:"LAB Cross-Site Scripting (XSS) attempt"; \
  flow:to_server,established; http.uri; \
  pcre:"/<script[^>]*>|onerror\s*=/i"; \
  classtype:web-application-attack; sid:9000003; rev:1;)

alert http any any -> any any (msg:"LAB Directory Traversal attempt"; \
  flow:to_server,established; http.uri.raw; \
  content:"../../"; \
  classtype:web-application-attack; sid:9000004; rev:1;)

alert http any any -> any any (msg:"LAB Command Injection attempt"; \
  flow:to_server,established; http.uri; \
  pcre:"/\x3b\s*(cat|whoami|id|ls)\b|\$\(.*\)/i"; \
  classtype:web-application-attack; sid:9000005; rev:1;)

# Behavioral: port scan — 6+ distinct SYNs to one host within 5s
alert tcp any any -> $HOME_NET any (msg:"LAB Possible Port Scan (6+ ports/5s)"; \
  flags:S; threshold:type both, track by_src, count 6, seconds 5; \
  classtype:attempted-recon; sid:9000006; rev:1;)

# Behavioral: SYN flood — 30+ SYNs to one host within 2s
alert tcp any any -> $HOME_NET any (msg:"LAB Possible SYN Flood / DoS (30+ pkts/2s)"; \
  flags:S; threshold:type both, track by_dst, count 30, seconds 2; \
  classtype:attempted-dos; sid:9000007; rev:1;)
